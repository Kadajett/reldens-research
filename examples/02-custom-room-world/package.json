{
  "name": "@reldens-tutorials/custom-room-world",
  "private": true,
  "version": "0.1.0",
  "description": "Custom room scenes, world/physics hooks and server-authoritative room logic.",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node index.js",
    "dev": "tsx watch src/index.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d"
  },
  "dependencies": {
    "reldens": "^4.0.0-beta.39.8"
  },
  "devDependencies": {
    "@reldens-tutorials/types": "*"
  },
  "browserslist": [
    "> 0.5%, last 2 versions, not dead"
  ],
  "targets": {
    "main": false
  },
  "alias": {
    "process": false
  },
  "reldensTutorial": {
    "appPort": 8082
  }
}
