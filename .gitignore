build/

# upstream clone, kept for reference only
reldens-source/

# Everything below is generated by Reldens inside an example folder.
# The platform lays these down on first run (ThemeManager.validateOrCreateTheme)
# or during the web install, so none of it is worth versioning.
examples/*/theme/
examples/*/dist/
examples/*/build-client/
examples/*/.env
examples/*/install.lock
examples/*/knexfile.js
examples/*/generated-entities/
examples/*/generate-data/generated/
examples/*/prisma/
examples/*/.parcel-cache/
examples/*/.gitignore

# parcel cache, created wherever the bundler runs
.parcel-cache/
